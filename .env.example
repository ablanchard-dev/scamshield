# Adjudication LLM (optionnelle, OFF par defaut). Copier ce fichier en `.env`
# et renseigner UNE seule cle — llm.py detecte automatiquement la premiere presente.
# `.env` est gitignore : ne jamais committer de vraie cle.
#
# Free tiers recommandes (aucune carte bancaire pour Groq / Cerebras) :
#   GROQ_API_KEY=...       # gratuit, 14 400 req/jour  -> console.groq.com
#   CEREBRAS_API_KEY=...   # gratuit, 1M tokens/jour   -> cloud.cerebras.ai
#   GEMINI_API_KEY=...     # gratuit, ~20 req/jour     -> aistudio.google.com
#   MISTRAL_API_KEY=...    # tier Experiment gratuit   -> console.mistral.ai
#   XAI_API_KEY=...        # NON gratuit (credits requis) -> console.x.ai
#
# Surcharge explicite d'un endpoint OpenAI-compatible quelconque (ex : Ollama local) :
#   SCAMSHIELD_LLM_BASE=http://localhost:11434/v1
#   SCAMSHIELD_LLM_MODEL=llama3.1
#   SCAMSHIELD_LLM_KEY=
